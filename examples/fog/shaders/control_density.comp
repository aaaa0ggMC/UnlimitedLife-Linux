#version 460
#extension GL_GOOGLE_include_directive : require
#define FOG_CONTROL_DENSITY_WRITE
#include "control_density.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
struct ControlPoint { vec4 position_radius; vec4 density_softness; };
struct ControlField {
    uvec4 info;
    vec4 noise;
    vec4 noise_offset;
    ControlPoint points[32];
};
layout(std430, set = 0, binding = 12) readonly buffer ControlFields { ControlField entries[]; } fields;
layout(push_constant) uniform ControlPush { uvec4 params; } push_data;

uint noise_hash(ivec3 p, uint seed) {
    uvec3 q = uvec3(p);
    uint h = q.x * 1597334677u ^ q.y * 3812015801u ^ q.z * 2798796415u ^ seed * 2246822519u;
    h = (h ^ (h >> 16u)) * 2246822519u;
    h = (h ^ (h >> 13u)) * 3266489917u;
    return h ^ (h >> 16u);
}

float gradient_dot(ivec3 cell, vec3 offset, uint seed) {
    const vec3 gradients[12] = vec3[12](
        vec3(1,1,0), vec3(-1,1,0), vec3(1,-1,0), vec3(-1,-1,0),
        vec3(1,0,1), vec3(-1,0,1), vec3(1,0,-1), vec3(-1,0,-1),
        vec3(0,1,1), vec3(0,-1,1), vec3(0,1,-1), vec3(0,-1,-1));
    return dot(gradients[noise_hash(cell, seed) % 12u], offset);
}

float gradient_noise(vec3 p, uint seed) {
    ivec3 base = ivec3(floor(p));
    vec3 f = fract(p);
    vec3 blend = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float result = 0.0;
    for(int z = 0; z < 2; ++z) for(int y = 0; y < 2; ++y) for(int x = 0; x < 2; ++x) {
        ivec3 corner = ivec3(x, y, z);
        vec3 weight = mix(1.0 - blend, blend, vec3(corner));
        result += weight.x * weight.y * weight.z * gradient_dot(base + corner, f - vec3(corner), seed);
    }
    return clamp(0.5 + 0.5 * result, 0.0, 1.0);
}

void main() {
    uvec3 cell = gl_GlobalInvocationID;
    if(any(greaterThanEqual(cell, uvec3(CONTROL_GRID_SIZE)))) return;
    uint slot = push_data.params.x;
    vec3 p = vec3(cell) / float(CONTROL_GRID_SIZE - 1u);
    float density = 0.0;
    for(uint i = 0u; i < min(fields.entries[slot].info.x, 32u); ++i) {
        ControlPoint point = fields.entries[slot].points[i];
        vec3 delta = p - point.position_radius.xyz;
        float radius = point.position_radius.w;
        float d2 = dot(delta, delta);
        if(d2 >= radius * radius || point.density_softness.x <= 0.0) continue;
        float q = sqrt(d2) / radius;
        density += point.density_softness.x * (1.0 - smoothstep(1.0 - point.density_softness.y, 1.0, q));
    }
    if(density > 0.0) {
        // Smooth bounded union: overlap strengthens the fog without hard clipping.
        density = 1.0 - exp(-density);
        if(fields.entries[slot].noise.y > 0.0) {
            vec3 q = p * fields.entries[slot].noise.x + fields.entries[slot].noise_offset.xyz;
            float amplitude = 1.0;
            float sum = 0.0;
            float norm = 0.0;
            for(uint octave = 0u; octave < min(fields.entries[slot].info.z, 5u); ++octave) {
                // Suppress octaves above grid Nyquist rather than bake spatial aliasing.
                float frequency = fields.entries[slot].noise.x * exp2(float(octave));
                float weight = amplitude * (1.0 - smoothstep(16.0, 32.0, frequency));
                if(weight <= 0.0) break;
                sum += weight * gradient_noise(q, fields.entries[slot].info.y + octave * 1013u);
                norm += weight;
                q = q * 2.0 + vec3(13.1, 7.7, 19.3);
                amplitude *= 0.5;
            }
            float noise = norm > 0.0 ? sum / norm : 0.5;
            density *= mix(1.0, smoothstep(0.2, 0.8, noise), fields.entries[slot].noise.y);
        }
    }
    control_density.values[slot * CONTROL_GRID_CELLS
        + (cell.z * CONTROL_GRID_SIZE + cell.y) * CONTROL_GRID_SIZE + cell.x] = density;
}
